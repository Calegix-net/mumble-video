# Managed by Ansible (qa/ansible).
[Unit]
Description=mumble-video QA loopback server ({{ mumble_video_ref }})
After=network.target

[Service]
Type=simple
ExecStart={{ qa_build_dir }}/mumble-server --foreground -i {{ qa_data_dir }}/mumble-server.ini
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
